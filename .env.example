# Copia este archivo como .env (o define estas variables en tu hosting).
# En tu computadora, "python manage.py preparar" crea el .env por ti.

# Clave secreta larga. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta-de-50-caracteres-o-mas

# 1 = desarrollo (muestra errores detallados). En internet debe ser 0.
DJANGO_DEBUG=0

# Dominios permitidos y origen seguro del formulario (con https://)
DJANGO_ALLOWED_HOSTS=pharmadel.com,www.pharmadel.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://pharmadel.com,https://www.pharmadel.com

# Dirección del panel privado (opcional, cámbiala por una menos obvia)
# DJANGO_ADMIN_URL=gestion-interna-x7/

# Base de datos PostgreSQL (opcional; sin esto usa SQLite)
# DATABASE_URL=postgres://usuario:clave@servidor:5432/nombre_bd

# Si usas SQLite o fotos locales en un disco persistente del hosting (opcional)
# DJANGO_DB_PATH=/data/db.sqlite3
# DJANGO_MEDIA_ROOT=/data/media
# DJANGO_SERVE_MEDIA=1

# Seguridad (opcional). Sube HSTS a 31536000 cuando el HTTPS ya funcione bien.
# DJANGO_HSTS_SECONDS=31536000

# Alertas de inventario por mensaje (opcional; sin esto el asistente solo responde en el panel)
# Cuenta en twilio.com. Con cuenta de prueba solo puedes enviar a números verificados en Twilio.
# ALERTAS_TELEFONOS=5555-1234          # varios separados por coma; 8 dígitos = Guatemala (+502)
# ALERTAS_CANAL=sms                    # sms o whatsapp
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=tu-token-secreto
# TWILIO_DESDE=+15005550006            # número de Twilio (en WhatsApp sandbox: +14155238886)
